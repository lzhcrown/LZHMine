<mujoco model="nezha gated-modal side-by-side terrain course">
  <include file="nezha.xml"/>

  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="coursetex" builtin="checker" mark="edge"
             rgb1="0.28 0.32 0.24" rgb2="0.16 0.20 0.13" markrgb="0.55 0.6 0.45"
             width="300" height="300"/>
    <material name="courseground" texture="coursetex" texuniform="true"
              texrepeat="8 8" reflectance="0.1"/>
    <!-- 25 m along x: 10 m staging + 10 m terrain + 5 m runout.
         40 m along y: seven side-by-side 5 m lanes plus side margins. -->
    <hfield name="terrain_course" file="../../../../mujoco/models/assets/nezha_terrain_course.bin"
            size="12.5 20 1.2 0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="training_terrain" type="hfield" hfield="terrain_course"
          pos="2.5 0 -0.6" material="courseground" contype="2" conaffinity="1"
          friction="1.0 0.01 0.001"/>
  </worldbody>
</mujoco>
