<mujoco model="nezha seven-lane terrain evaluation course">
  <include file="nezha.xml"/>
  <include file="course_geometry.xml"/>

  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.72 0.80 0.90" ambient="0.30 0.38 0.48"
               specular="0.25 0.30 0.36"/>
    <global azimuth="-135" elevation="-22" offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096" offsamples="4"/>
    <map znear="0.02" zfar="100" fogstart="50" fogend="85"/>
    <rgba haze="0.08 0.17 0.28 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.12 0.30 0.48" rgb2="0.01 0.04 0.10"
             width="512" height="3072"/>
    <texture type="2d" name="coursetex" builtin="checker" mark="edge"
             rgb1="0.025 0.105 0.205" rgb2="0.095 0.355 0.565"
             markrgb="0.32 0.68 0.90" width="512" height="512"/>
    <material name="courseground" texture="coursetex" texuniform="true"
              texrepeat="1 1" reflectance="0.16" specular="0.18"
              shininess="0.25"/>
    <!-- Seven 5 m lanes and 2.5 m margins: 25 m along x, 40 m along y.
         Solid stairs, smooth ramps, and the rough lane are generated together
         in course_geometry.xml; edit tools/generate_terrain_course.py. -->
  </asset>

  <worldbody>
    <light pos="-4 -6 10" dir="0.35 0.25 -1" directional="true"
           diffuse="0.85 0.90 1.0" specular="0.25 0.30 0.38" castshadow="true"/>
    <light pos="5 7 6" dir="-0.30 -0.40 -1" directional="true"
           diffuse="0.35 0.50 0.70" specular="0.10 0.15 0.22"/>
  </worldbody>
</mujoco>
