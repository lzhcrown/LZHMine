# Local Python environments
.venv/
.venv-*/
venv/
venv-*/
.tox/
.nox/
__pypackages__/

# Local agent/account state
/.agents/
/.codex/
/.aws/

# Training logs and experiment trackers
logs/
evaluations/
runs/
wandb/
.tensorboard-info/
*.log
nohup.out
MUJOCO_LOG.TXT
events.out.tfevents.*

# Model checkpoints and exported policies
# Ignore the whole export directory, including policy.json and future metadata.
deploy/**/policy/
*.pt
*.pth
*.onnx
*.jit
*.ckpt
*.safetensors
*.tflite

# Optional deployment recordings and visualization output
deploy/**/frames/
deploy/**/videos/
deploy/**/recordings/
deploy/**/screenshots/

# Generated previews that are not loaded by MuJoCo
deploy/deploy_mujoco/nezha/mjcf/assets/nezha_rough_slope.png
deploy/deploy_mujoco/nezha/mjcf/assets/nezha_training_curriculum.png

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.cache/
.ipynb_checkpoints/

# Local GPU/compiler caches (the default Gym extension cache lives in /tmp)
/.triton/
/.nv/
/.torch_extensions/
/torch_extensions/

# Python package/build artifacts
*.egg-info/
.eggs/
build/
dist/
*.whl
*.egg

# Compiled native extensions and Ninja state; keep mesh formats such as *.obj.
*.so
*.so.[0-9]*
*.o
*.a
.ninja_deps
.ninja_log

# Test and coverage outputs
.coverage
.coverage.*
htmlcov/
coverage.xml
TEST*.xml
*.prof
*.trace.json

# Editor settings and temporary files
tmp/
.vscode/
.idea/
.marscode/
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# Root-level process crash dumps; avoid a broad core.* rule that hides source.
/core
/core.[0-9]*

# Local secrets
.env
.env.*
!.env.example

# Operating-system metadata
.DS_Store
Thumbs.db

# Keep robot descriptions and their mesh/material dependencies versioned.
# Do not add blanket rules for resources/, URDF, MJCF/XML, STL, OBJ or BIN:
# the simulation scenes load the tracked terrain heightfields as well.
# Keep source/config/test data (including CSV, JSON, PNG and PDF) eligible too.
# Put custom evaluation/export output under evaluations/, logs/, tmp/, or the
# existing deploy/**/policy/ directory instead of ignoring those file formats.
# .python-version, requirements/ and lock files belong in version control.
!*.urdf
!*.xacro
